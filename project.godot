; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="dot-progression"
config/description="Godot 4.7+ addon for XP, levels, season and battle-pass tracks, daily and weekly challenges and unlock tables as a bounded document a dedicated server can validate, reporting to the TMC backbone. Part of the GameSpice addon family."
run/main_scene="res://examples/progression_selftest.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"


[editor_plugins]

enabled=PackedStringArray("res://addons/dot_progression/plugin.cfg")

[importer_defaults]

texture={
"detect_3d/compress_to": 0
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
